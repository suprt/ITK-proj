# ─── GRPC ───
GRPC_ADDR=:50051
GRPC_STOP_TIMEOUT=15s

# ─── JWT ───
JWT_SECRET=dev-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── LOG ───
LOG_LEVEL=info
LOG_FORMAT=console

# ─── CONFIG PATH ───
CONFIG_PATH=config.yaml

# ─── CRYPTO ───
CRYPTO_HASH_COST = 10

# ─── POSTGRES ───
POSTGRES_DSN=postgres://trading:trading@localhost:5432/user_db?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_MAX_LIFETIME=5m