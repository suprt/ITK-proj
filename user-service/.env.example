# ─── GRPC ───
GRPC_ADDR=:50051
GRPC_STOP_TIMEOUT=15s

# ─── JWT ───
JWT_SECRET=dev-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── LOG ───
LOG_LEVEL=debug
LOG_FORMAT=console

# ─── CONFIG PATH ───
CONFIG_PATH=config.yaml

# ─── CRYPTO ───
CRYPTO_HASH_COST = 10

# ─── POSTGRES ───
POSTGRES_DSN=postgres://trading:trading@localhost:5432/user_db?sslmode=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=5m
POSTGRES_MAX_CONN_IDLE_TIME=1m

# ─── REDIS ───
REDIS_ADDR=redis:6379
# REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_password
REDIS_USER=redis_user
REDIS_DB=0

# ─── CACHE ───
CACHE_USER_TTL=2h
CACHE_USER_NOT_FOUND_TTL=5m

# ─── IDEMPOTENCY ───
IDEMPOTENCY_TTL=1h