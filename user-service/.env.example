# ─── GRPC ───
GRPC_ADDR=:50051
GRPC_STOP_TIMEOUT=15s

# ─── JWT ───
JWT_SECRET=dev-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── LOG ─── (встроен из sharedconfig.Log)
LOG_LEVEL=info
LOG_FORMAT=console

# ─── CONFIG PATH ─── (читается через os.Getenv в app.Start)
CONFIG_PATH=config.yaml